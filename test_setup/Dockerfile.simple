FROM debian:bookworm-slim AS base

# Variables de entorno
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    GUTENBERG_ENV=docker \
    DJANGO_SETTINGS_MODULE=gutenberg.settings.docker_settings

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    # Herramientas básicas
    curl \
    git \
    vim \
    netcat-traditional \
    sudo \
    # CUPS para impresión
    cups \
    cups-client \
    cups-bsd \
    # Dependencias de Gutenberg
    libreoffice-core-nogui \
    libreoffice-writer-nogui \
    imagemagick \
    ghostscript \
    bubblewrap \
    # Node.js y npm (solo para backend, no construimos webapp)
    nodejs \
    npm \
    # Dependencias de Python
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Instalar uv (gestor de paquetes Python)
RUN pip3 install --break-system-packages uv

# Verificar instalación de uv
RUN uv --version

# Crear directorio de trabajo
WORKDIR /app

# Clonar el repositorio de Gutenberg
RUN git clone https://github.com/KSIUJ/gutenberg.git /app

# Configurar el backend
WORKDIR /app/backend

# Crear usuario gutenberg-docker con UID/GID específicos
ARG GUTENBERG_USERNAME=gutenberg-docker
ARG GUTENBERG_UID=659
ARG GUTENBERG_GID=659

RUN groupadd --system --gid ${GUTENBERG_GID} ${GUTENBERG_USERNAME} && \
    useradd --system --uid ${GUTENBERG_UID} --gid ${GUTENBERG_GID} \
    --home-dir /app ${GUTENBERG_USERNAME} && \
    echo "${GUTENBERG_USERNAME} ALL=(ALL) NOPASSWD: /usr/sbin/cupsd" >> /etc/sudoers

# Instalar dependencias de Python
RUN uv sync

# Copiar configuración de ejemplo
RUN cp gutenberg/settings/docker_settings.py.example gutenberg/settings/docker_settings.py

# Cambiar propiedad de archivos
RUN chown -R ${GUTENBERG_USERNAME}:${GUTENBERG_USERNAME} /app

# Volver al directorio del backend
WORKDIR /app/backend

# Configurar CUPS
RUN mkdir -p /var/run/cups /var/spool/cups /etc/cups && \
    chmod 755 /var/run/cups /var/spool/cups && \
    chown -R ${GUTENBERG_USERNAME}:${GUTENBERG_USERNAME} /var/run/cups /var/spool/cups /etc/cups

# Configurar CUPS para permitir acceso local sin autenticación
RUN echo "# Permitir acceso local sin autenticación" > /etc/cups/cupsd.conf && \
    echo "<Location />" >> /etc/cups/cupsd.conf && \
    echo "  Order allow,deny" >> /etc/cups/cupsd.conf && \
    echo "  Allow localhost" >> /etc/cups/cupsd.conf && \
    echo "</Location>" >> /etc/cups/cupsd.conf && \
    echo "<Location /admin>" >> /etc/cups/cupsd.conf && \
    echo "  Order allow,deny" >> /etc/cups/cupsd.conf && \
    echo "  Allow localhost" >> /etc/cups/cupsd.conf && \
    echo "</Location>" >> /etc/cups/cupsd.conf

# Exponer puertos
EXPOSE 8000 631

# Cambiar al usuario gutenberg-docker
USER ${GUTENBERG_USERNAME}

# Script de inicio
COPY --chown=${GUTENBERG_USERNAME}:${GUTENBERG_USERNAME} docker-entrypoint.sh /usr/local/bin/
USER root
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
USER ${GUTENBERG_USERNAME}

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["web"]
