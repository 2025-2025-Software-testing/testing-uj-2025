# Variables de entorno para Gutenberg Docker

# Contraseña de PostgreSQL
POSTGRES_PASSWORD=gutenberg_change_me_in_production

# Clave secreta de Django (genera una aleatoria para producción)
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Para generar una clave segura, ejecuta:
# openssl rand -base64 50
